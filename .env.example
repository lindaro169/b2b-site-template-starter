# Environment Variables Template
# Copy this file to .env.local and fill in your actual values
# IMPORTANT: .env.local is in .gitignore and will NEVER be committed to Git

# ============================================
# Cloudflare Turnstile Configuration
# Get these from: https://dash.cloudflare.com/
# ============================================
# This is the PUBLIC key - safe to expose in frontend code
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=your_site_key_here

# This is the SECRET key - NEVER expose in frontend or commit to Git
CLOUDFLARE_TURNSTILE_SECRET_KEY=your_secret_key_here

# ============================================
# Google OAuth Configuration
# Get this from: https://console.cloud.google.com/
# ============================================
# This is PUBLIC - safe to expose (it's just the Client ID)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_client_id_here

# This is SECRET - NEVER expose in frontend or commit to Git
GOOGLE_CLIENT_SECRET=your_client_secret_here

# ============================================
# Better Auth Configuration
# ============================================
# This is SECRET - NEVER commit to Git
BETTER_AUTH_SECRET=your_random_secret_key_here

# ============================================
# JWT Authentication
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ============================================
# This is SECRET - NEVER commit to Git
JWT_SECRET=your_random_secret_key_here

# ============================================
# API Configuration
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:3002

# ============================================
# Resend Email Configuration
# Create in: https://resend.com/api-keys
# IMPORTANT: API key full value is shown only once
# ============================================
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=sales@your-domain.com
SALES_NOTIFICATION_EMAIL=sales@your-domain.com

# ============================================
# Google Ads Website Conversion
# Fill these after creating the conversion action in Google Ads
# ============================================
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_ADS_INQUIRY_LABEL=your_google_ads_inquiry_label

# ============================================
# Google Ads HTTPS Feed Basic Auth
# Used by /api/google-ads/leads-feed.csv
# ============================================
GOOGLE_ADS_FEED_USERNAME=your_google_ads_feed_username
GOOGLE_ADS_FEED_PASSWORD=your_google_ads_feed_password

# ============================================
# Database Configuration (Optional)
# ============================================
# DATABASE_URL=your_database_connection_string_here
