{
  "name": "template-catalog-starter",
  "version": "1.0.0",
  "private": true,
  "description": "Sanitized wholesale jewelry template with mock data and placeholder assets",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "next dev -p 3002",
    "db:local:migrate": "wrangler d1 migrations apply template_site_placeholder --local",
    "db:local:seed": "tsx scripts/seed_local_d1.ts",
    "db:local:seed:dry": "tsx scripts/seed_local_d1.ts --dry-run",
    "db:local:setup": "pnpm db:local:migrate && pnpm db:local:seed",
    "build": "next build && opennextjs-cloudflare build --skipNextBuild",
    "postbuild": "node -e \"const fs = require('fs'); fs.writeFileSync('./.open-next/assets/.assetsignore', '_worker.js\\n');\"",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "better-auth": "^1.5.6",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.41.0",
    "echarts": "^5.5.1",
    "echarts-for-react": "^3.0.2",
    "embla-carousel-react": "^8.3.1",
    "exceljs": "4.4.0",
    "jose": "^6.1.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.562.0",
    "marked": "^15.0.0",
    "marked-highlight": "^2.2.1",
    "mini-svg-data-uri": "^1.4.4",
    "next": "^15.5.10",
    "prismjs": "^1.29.0",
    "react": "^19.1.2",
    "react-collapse": "^5.1.1",
    "react-dom": "^19.1.2",
    "react-share": "^5.2.2",
    "react-turnstile": "^1.1.4",
    "sanitize-html": "2.17.2",
    "sharp": "^0.33.5",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.18.0",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^22.0.0",
    "@types/prismjs": "^1.26.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.21",
    "baseline-browser-mapping": "2.10.9",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^8",
    "eslint-config-next": "^15.5.14",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.78.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<1.1.13": "1.1.13",
      "brace-expansion@>=2.0.0 <2.0.3": "2.0.3",
      "esbuild@<=0.24.2": "0.25.11",
      "glob@>=10.2.0 <10.5.0": "10.5.0",
      "minimatch@<3.1.4": "3.1.4",
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "4.0.4",
      "rollup@>=4.0.0 <4.59.0": "4.59.0",
      "vite": "6.4.1",
      "yaml": "2.8.3"
    }
  },
  "engines": {
    "pnpm": ">=9.0.0",
    "node": ">=18.0.0"
  }
}
