{
  "name": "template-catalog-starter",
  "version": "1.0.0",
  "private": true,
  "description": "Sanitized wholesale jewelry template with mock data and placeholder assets",
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build && opennextjs-cloudflare build --skipNextBuild",
    "postbuild": "node -e \"const fs = require('fs'); fs.writeFileSync('./.open-next/assets/.assetsignore', '_worker.js\\n');\"",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@tailwindcss/typography": "^0.5.15",
    "better-auth": "^1.4.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.38.0",
    "echarts": "^5.5.1",
    "echarts-for-react": "^3.0.2",
    "embla-carousel-react": "^8.3.1",
    "isomorphic-dompurify": "^2.16.0",
    "itty-router": "^5.0.22",
    "jose": "^6.1.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.562.0",
    "marked": "^15.0.0",
    "marked-highlight": "^2.2.1",
    "mini-svg-data-uri": "^1.4.4",
    "next": "^15.5.7",
    "prismjs": "^1.29.0",
    "react": "^19.1.2",
    "react-collapse": "^5.1.1",
    "react-dom": "^19.1.2",
    "react-share": "^5.2.2",
    "react-turnstile": "^1.1.4",
    "sharp": "^0.33.5",
    "tailwind-merge": "^2.5.4",
    "wrangler": "^4.56.0",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.11.0",
    "@types/node": "^22.0.0",
    "@types/prismjs": "^1.26.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.21",
    "baseline-browser-mapping": "2.10.9",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.5",
    "eslint": "^8",
    "eslint-config-next": "^15.5.3",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "vitest": "^0.34.0"
  },
  "engines": {
    "pnpm": ">=9.0.0",
    "node": ">=18.0.0"
  }
}
